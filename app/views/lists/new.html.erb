<div class="container mt-5" style="max-width: 600px;">
  <div class="card shadow-sm">
    <div class="card-body p-4">
      <h1 class="h3 fw-bold mb-4">New List</h1>

      <%= simple_form_for @list do |f| %>
        <%= f.input :name, placeholder: "e.g. Drama, Classics, Sci-Fi..." %>

        <div class="d-flex justify-content-between align-items-center mt-4">
          <%= link_to "Back to lists", lists_path, class: "btn btn-outline-secondary" %>
          <%= f.submit "Create List", class: "btn btn-success text-white" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
